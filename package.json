{
  "name": "reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "bun run css && bun run vendor",
    "dev": "bun run build && bun --watch src/server.ts",
    "start": "bun run build && bun run src/server.ts",
    "css": "bunx @tailwindcss/cli -i src/styles.css -o public/app.css --minify",
    "vendor": "bun run build:vendor",
    "build:vendor": "bun build src/vendor/marked.js src/vendor/sugar.js src/vendor/alpine.js --minify --target=browser --format=esm --outdir=public/vendor --entry-naming=[name].min.js"
  },
  "dependencies": {
    "alpinejs": "^3.17.5",
    "marked": "^18.1.1",
    "sugar-high": "^2.6.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "daisyui": "^5.7.50",
    "tailwindcss": "^4.3.3"
  }
}
